<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>FinTrack Pro – Expense & Budget Manager</title>

<style>
:root{
    --primary:#16a34a;
    --danger:#dc2626;
    --accent:#2563eb;
    --bg:#f0fdf4;
    --card:#ffffff;
    --text:#052e16;
}

*{box-sizing:border-box;font-family:"Segoe UI",system-ui,sans-serif}

body{
    margin:0;
    background:linear-gradient(135deg,#dcfce7,#f0fdf4);
    min-height:100vh;
    padding:24px;
    color:var(--text);
}

.app{max-width:1200px;margin:auto}

header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:20px;
}

.stats{
    display:grid;
    grid-template-columns:repeat(3,1fr);
    gap:16px;
    margin-bottom:20px;
}

.card{
    background:var(--card);
    border-radius:18px;
    padding:18px;
    box-shadow:0 20px 40px rgba(0,0,0,.12);
}

.stat{
    font-size:14px;
    color:#166534;
}

.amount{
    font-size:26px;
    font-weight:800;
}

.grid{
    display:grid;
    grid-template-columns:320px 1fr;
    gap:20px;
}

label{font-weight:600;font-size:14px}

input,select{
    width:100%;
    padding:10px;
    margin:8px 0 14px;
    border-radius:10px;
    border:1px solid #86efac;
}

button{
    width:100%;
    padding:12px;
    border:none;
    border-radius:12px;
    font-weight:700;
    cursor:pointer;
}

.primary{background:var(--primary);color:#fff}
.danger{background:var(--danger);color:#fff}

.expense{
    display:flex;
    justify-content:space-between;
    align-items:center;
    background:#dcfce7;
    padding:12px;
    border-radius:12px;
    margin-bottom:10px;
}

.category{
    font-size:13px;
    color:#166534;
}

.empty{
    text-align:center;
    color:#15803d;
    padding:30px;
}
</style>
</head>

<body>

<div class="app">

<header>
    <h1>💰 FinTrack Pro</h1>
</header>

<div class="stats">
    <div class="card">
        <div class="stat">Total Income</div>
        <div class="amount">₹<span id="income">0</span></div>
    </div>
    <div class="card">
        <div class="stat">Total Expense</div>
        <div class="amount">₹<span id="expense">0</span></div>
    </div>
    <div class="card">
        <div class="stat">Balance</div>
        <div class="amount">₹<span id="balance">0</span></div>
    </div>
</div>

<div class="grid">

<div class="card">
    <h2>Add Transaction</h2>

    <label>Type</label>
    <select id="type">
        <option value="income">Income</option>
        <option value="expense">Expense</option>
    </select>

    <label>Category</label>
    <select id="category">
        <option>Salary</option>
        <option>Food</option>
        <option>Shopping</option>
        <option>Travel</option>
        <option>Bills</option>
        <option>Other</option>
    </select>

    <label>Amount</label>
    <input type="number" id="amount" placeholder="Enter amount">

    <button class="primary" onclick="addTransaction()">Add</button>
</div>

<div class="card">
    <h2>Transaction History</h2>
    <div id="list"></div>
</div>

</div>
</div>

<script>
let data = JSON.parse(localStorage.getItem("finance")) || [];

function addTransaction(){
    const type=typeEl.value;
    const category=categoryEl.value;
    const amount=Number(amountEl.value);

    if(!amount || amount<=0){alert("Enter valid amount");return;}

    data.push({type,category,amount});
    save();
    amountEl.value="";
    render();
}

function removeTransaction(i){
    data.splice(i,1);
    save();
    render();
}

function render(){
    let income=0, expense=0;
    list.innerHTML="";

    if(data.length===0){
        list.innerHTML=`<div class="empty">No transactions yet</div>`;
    }

    data.forEach((t,i)=>{
        t.type==="income" ? income+=t.amount : expense+=t.amount;

        list.innerHTML+=`
        <div class="expense">
            <div>
                <strong>${t.type==="income" ? "+" : "-"} ₹${t.amount}</strong>
                <div class="category">${t.category}</div>
            </div>
            <button class="danger" onclick="removeTransaction(${i})">x</button>
        </div>`;
    });

    incomeEl.innerText=income;
    expenseEl.innerText=expense;
    balanceEl.innerText=income-expense;
}

function save(){
    localStorage.setItem("finance",JSON.stringify(data));
}

const typeEl=document.getElementById("type");
const categoryEl=document.getElementById("category");
const amountEl=document.getElementById("amount");
const list=document.getElementById("list");

const incomeEl=document.getElementById("income");
const expenseEl=document.getElementById("expense");
const balanceEl=document.getElementById("balance");

render();
</script>

</body>
</html>
