<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>SkillSphere – Learning Progress Tracker</title>

<style>
:root{
    --primary:#7c3aed;
    --accent:#22c55e;
    --danger:#ef4444;
    --bg:#f5f3ff;
    --card:#ffffff;
    --text:#1e1b4b;
}

*{box-sizing:border-box;font-family:"Segoe UI",system-ui,sans-serif}

body{
    margin:0;
    background:linear-gradient(135deg,#ede9fe,#f5f3ff);
    min-height:100vh;
    padding:24px;
    color:var(--text);
}

.app{max-width:1200px;margin:auto}

header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:20px;
}

.grid{
    display:grid;
    grid-template-columns:320px 1fr;
    gap:20px;
}

.card{
    background:var(--card);
    border-radius:20px;
    padding:20px;
    box-shadow:0 20px 40px rgba(0,0,0,.15);
}

label{font-weight:600;font-size:14px}

input,select{
    width:100%;
    padding:10px;
    margin:8px 0 16px;
    border-radius:10px;
    border:1px solid #ddd6fe;
}

button{
    width:100%;
    padding:12px;
    border:none;
    border-radius:12px;
    font-weight:700;
    cursor:pointer;
}

.primary{background:var(--primary);color:#fff}
.danger{background:var(--danger);color:#fff}

.skill{
    background:#ede9fe;
    border-radius:14px;
    padding:12px;
    margin-bottom:12px;
}

.skill-header{
    display:flex;
    justify-content:space-between;
    align-items:center;
}

.progress{
    height:8px;
    background:#ddd6fe;
    border-radius:8px;
    overflow:hidden;
    margin-top:8px;
}

.progress span{
    display:block;
    height:100%;
    background:var(--accent);
}

.empty{
    text-align:center;
    color:#6d28d9;
    padding:30px;
}
</style>
</head>

<body>

<div class="app">

<header>
    <h1>📚 SkillSphere</h1>
</header>

<div class="grid">

<div class="card">
    <h2>Add Skill</h2>

    <label>Skill Name</label>
    <input id="skill" placeholder="JavaScript, UI Design...">

    <label>Category</label>
    <select id="category">
        <option>Frontend</option>
        <option>Backend</option>
        <option>Data</option>
        <option>AI / ML</option>
        <option>Soft Skills</option>
    </select>

    <label>Progress (%)</label>
    <input type="number" id="progress" min="0" max="100" placeholder="0 - 100">

    <button class="primary" onclick="addSkill()">Save Skill</button>
</div>

<div class="card">
    <h2>My Learning Progress</h2>
    <div id="skills"></div>
</div>

</div>
</div>

<script>
let skills = JSON.parse(localStorage.getItem("skills")) || [];

function addSkill(){
    const skill=skillEl.value.trim();
    const category=categoryEl.value;
    const progress=Number(progressEl.value);

    if(!skill || progress<0 || progress>100){
        alert("Enter valid data");
        return;
    }

    skills.push({skill,category,progress});
    save();
    clear();
    render();
}

function removeSkill(i){
    skills.splice(i,1);
    save();
    render();
}

function render(){
    skillsBox.innerHTML="";

    if(skills.length===0){
        skillsBox.innerHTML=`<div class="empty">No skills added yet</div>`;
        return;
    }

    skills.forEach((s,i)=>{
        skillsBox.innerHTML+=`
        <div class="skill">
            <div class="skill-header">
                <strong>${s.skill}</strong>
                <button class="danger" onclick="removeSkill(${i})">x</button>
            </div>
            <small>${s.category} • ${s.progress}%</small>
            <div class="progress">
                <span style="width:${s.progress}%"></span>
            </div>
        </div>`;
    });
}

function clear(){
    skillEl.value="";
    progressEl.value="";
}

function save(){
    localStorage.setItem("skills",JSON.stringify(skills));
}

const skillEl=document.getElementById("skill");
const categoryEl=document.getElementById("category");
const progressEl=document.getElementById("progress");
const skillsBox=document.getElementById("skills");

render();
</script>

</body>
</html>
