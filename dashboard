<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>InsightX – Advanced Analytics Dashboard</title>

<style>
:root{
  --bg:#020617;
  --panel:#020617;
  --card:#020617;
  --accent:#38bdf8;
  --danger:#ef4444;
  --success:#22c55e;
  --text:#e5e7eb;
  --muted:#94a3b8;
}
*{box-sizing:border-box;font-family:Inter,system-ui}
body{
  margin:0;
  background:radial-gradient(circle at top,#020617,#020617);
  color:var(--text);
}
.sidebar{
  width:260px;
  height:100vh;
  position:fixed;
  background:#020617;
  border-right:1px solid #1e293b;
  padding:22px;
}
.sidebar h2{margin:0 0 20px}
.sidebar a{
  display:block;
  padding:10px 14px;
  margin-bottom:8px;
  border-radius:10px;
  text-decoration:none;
  color:var(--text);
}
.sidebar a.active,
.sidebar a:hover{background:#020617}

.main{
  margin-left:260px;
  padding:24px;
}
.top{
  display:flex;
  justify-content:space-between;
  margin-bottom:24px;
}
.cards{
  display:grid;
  grid-template-columns:repeat(4,1fr);
  gap:18px;
}
.card{
  background:#020617;
  border-radius:20px;
  padding:18px;
  box-shadow:0 20px 40px rgba(0,0,0,.5);
}
.card h3{margin:0;font-size:14px;color:var(--muted)}
.card p{font-size:26px;margin:8px 0 0}

.chart{
  margin-top:30px;
  background:#020617;
  padding:24px;
  border-radius:20px;
}
.bar{
  display:flex;
  gap:10px;
  align-items:flex-end;
  height:220px;
}
.bar span{
  flex:1;
  background:var(--accent);
  border-radius:8px;
}
.filters{
  display:flex;
  gap:12px;
}
.filters select{
  padding:8px;
  border-radius:10px;
  border:none;
}
</style>
</head>

<body>

<div class="sidebar">
  <h2>InsightX</h2>
  <a class="active">Dashboard</a>
  <a>Reports</a>
  <a>Users</a>
  <a>Settings</a>
</div>

<div class="main">

<div class="top">
  <h1>Analytics Overview</h1>
  <div class="filters">
    <select onchange="updateChart(this.value)">
      <option value="week">Last Week</option>
      <option value="month">Last Month</option>
    </select>
  </div>
</div>

<div class="cards">
  <div class="card"><h3>Total Users</h3><p id="u">0</p></div>
  <div class="card"><h3>Revenue</h3><p id="r">$0</p></div>
  <div class="card"><h3>Orders</h3><p id="o">0</p></div>
  <div class="card"><h3>Conversion</h3><p id="c">0%</p></div>
</div>

<div class="chart">
  <h3>Performance</h3>
  <div class="bar" id="chart"></div>
</div>

</div>

<script>
const data={
  week:[40,55,70,60,80,65,90],
  month:[120,150,180,160,200,175,220]
};

function updateStats(values){
  u.textContent=values.reduce((a,b)=>a+b);
  r.textContent="$"+(u.textContent*3);
  o.textContent=Math.floor(u.textContent/2);
  c.textContent=Math.floor(Math.random()*20+60)+"%";
}

function updateChart(type){
  chart.innerHTML="";
  data[type].forEach(v=>{
    const bar=document.createElement("span");
    bar.style.height=v+"%";
    chart.appendChild(bar);
  });
  updateStats(data[type]);
}

updateChart("week");
</script>

</body>
</html>
