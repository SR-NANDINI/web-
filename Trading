<!DOCTYPE html>
<html>
<head>
<title>CryptoX Pro – Trading Dashboard</title>

<style>
*{
box-sizing:border-box;
font-family:Inter,system-ui;
}

body{
margin:0;
background:#020617;
color:white;
}

header{
padding:20px;
background:#020617;
border-bottom:1px solid #1e293b;
font-size:22px;
font-weight:bold;
}

.container{
display:grid;
grid-template-columns:2fr 1fr;
gap:20px;
padding:20px;
}

.card{
background:#0f172a;
padding:20px;
border-radius:12px;
}

table{
width:100%;
border-collapse:collapse;
}

th,td{
padding:10px;
text-align:left;
}

tr:hover{
background:#1e293b;
}

button{
padding:6px 12px;
border:none;
border-radius:6px;
cursor:pointer;
}

.buy{
background:#22c55e;
color:white;
}

.sell{
background:#ef4444;
color:white;
}

input{
padding:8px;
width:100%;
margin-bottom:10px;
border-radius:6px;
border:none;
}

.green{color:#22c55e}
.red{color:#ef4444}

</style>
</head>
<body>

<header>
CryptoX Pro Trading Dashboard
</header>

<div class="container">

<div class="card">

<h3>Market</h3>

<table>
<thead>
<tr>
<th>Coin</th>
<th>Price</th>
<th>Action</th>
</tr>
</thead>

<tbody id="market"></tbody>

</table>

</div>

<div>

<div class="card">

<h3>Balance: ₹ <span id="balance"></span></h3>

<input id="amount" placeholder="Amount">

</div>

<div class="card">

<h3>Portfolio</h3>

<div id="portfolio"></div>

</div>

<div class="card">

<h3>History</h3>

<div id="history"></div>

</div>

</div>

</div>

<script>

let coins = {
Bitcoin:3000000,
Ethereum:200000,
Solana:8000
};

let user = JSON.parse(localStorage.getItem("cryptoUser")) || {
balance:100000,
portfolio:{},
history:[]
};

function save(){
localStorage.setItem("cryptoUser",JSON.stringify(user));
}

function renderMarket(){

market.innerHTML="";

Object.keys(coins).forEach(name=>{

let price=coins[name];

market.innerHTML+=`
<tr>
<td>${name}</td>
<td>₹ ${price}</td>
<td>
<button class="buy" onclick="buy('${name}')">Buy</button>
<button class="sell" onclick="sell('${name}')">Sell</button>
</td>
</tr>
`;

});

}

function renderPortfolio(){

portfolio.innerHTML="";

Object.keys(user.portfolio).forEach(name=>{

portfolio.innerHTML+=`
<div>
${name}: ${user.portfolio[name]}
</div>
`;

}

function renderHistory(){

history.innerHTML="";

user.history.slice().reverse().forEach(t=>{

history.innerHTML+=`
<div class="${t.type==='BUY'?'green':'red'}">
${t.type} ${t.coin} ₹${t.price}
</div>
`;

});

}

function renderBalance(){

balance.innerText=user.balance;

}

function buy(coin){

let amt=parseInt(amount.value);

if(!amt) return;

let price=coins[coin];

let qty=amt/price;

if(user.balance<amt){
alert("Insufficient balance");
return;
}

user.balance-=amt;

user.portfolio[coin]=(user.portfolio[coin]||0)+qty;

user.history.push({
type:"BUY",
coin,
price:amt
});

save();

update();

}

function sell(coin){

let amt=parseInt(amount.value);

if(!amt) return;

let price=coins[coin];

let qty=amt/price;

if(!user.portfolio[coin] || user.portfolio[coin]<qty){
alert("Not enough coin");
return;
}

user.balance+=amt;

user.portfolio[coin]-=qty;

user.history.push({
type:"SELL",
coin,
price:amt
});

save();

update();

}

function update(){

renderMarket();
renderPortfolio();
renderHistory();
renderBalance();

}

setInterval(()=>{

Object.keys(coins).forEach(c=>{

let change=(Math.random()-0.5)*10000;

coins[c]+=Math.floor(change);

});

renderMarket();

},2000);

update();

</script>

</body>
</html>
